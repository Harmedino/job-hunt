# Copy to .env.local. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=job_hunt
# Required in production. HTTP Basic auth username can be anything; use HTTPS.
APP_PASSWORD=
# Optional: without a key, preparation uses an explicitly labeled factual template.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Required for scheduled requests: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
