# Copy to .env.local. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=job_hunt
# Required in production. Used by the sign-in page; no username is needed. Use HTTPS.
APP_PASSWORD=
# Optional OpenAI connection for CV extraction, tailored CV writing with factual checks, and evidence ranking.
# Create at https://platform.openai.com/api-keys with API billing enabled.
# Server-side only. In Vercel set for Production/Preview as needed, then redeploy.
# Without a key, recognised CV sections and a factual application template still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Required for scheduled requests: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Alternative AI provider: Google Gemini. Create your own key at https://aistudio.google.com/apikey
# Keep it server-side. Review provider data-use terms before sending personal CVs.
# In Vercel add GEMINI_API_KEY for Production and redeploy, then use Test AI connection.
GEMINI_API_KEY=
# auto: keep existing OpenAI connections; otherwise use Gemini. Explicit choices: gemini or openai.
AI_PROVIDER=auto
# auto uses Google's gemini-flash-latest alias; override with a valid text model ID if needed.
GEMINI_MODEL=auto
