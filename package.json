{
  "name": "job-hunt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:auth": "node tests/production/auth.mjs",
    "test:cv": "node tests/production/cv-upload.mjs",
    "test:builder": "node tests/production/cv-builder.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate:modules": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-modules.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.12.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "mongodb": "^7.7.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jszip": "^3.10.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
